{
	"name": "ds_automated_date_pipe",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ls_datalake",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"folderpath": {
				"type": "string"
			},
			"filename": {
				"type": "string",
				"defaultValue": "@string('')"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().filename",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat('source/',dataset().folderpath)",
					"type": "Expression"
				},
				"fileSystem": "adventureworks"
			},
			"columnDelimiter": "|",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}