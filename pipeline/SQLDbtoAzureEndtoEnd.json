{
	"name": "SQLDbtoAzureEndtoEnd",
	"properties": {
		"description": "On prem sql data gets laoded daily. \n\nLoad that data into the azure db.\n\nData on onprem db, is loaded gradually, A control table(azuresynccontrol) is updated when the data load is complete.  Pipeline automatically runs once the data is updated to completed.",
		"activities": [
			{
				"name": "AllTablesLoaded",
				"type": "Until",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@variables('IsAllCompleted')",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "LookupTableStatus",
							"description": "Check if all tables are loaded.",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"sqlReaderQuery": "SELECT COUNT(*) AS PendingCount FROM dbo.AzureSyncControl WHERE LoadDate = CAST(GETDATE() AS DATE) AND Status != 'COMPLETED';",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "SqlServerTable",
									"type": "DatasetReference",
									"parameters": {
										"table": "''"
									}
								},
								"firstRowOnly": true
							}
						},
						{
							"name": "CheckIfReady",
							"description": "Check if the pending count is equal to 0 (meaning all tables are done):",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "LookupTableStatus",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(activity('LookupTableStatus').output.firstRow.PendingCount, 0)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Wait",
										"type": "Wait",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"waitTimeInSeconds": 15
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "SetVariableCompleted",
										"type": "SetVariable",
										"dependsOn": [],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "IsAllCompleted",
											"value": true
										}
									}
								]
							}
						}
					],
					"timeout": "0.12:00:00"
				}
			},
			{
				"name": "LoadTables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "GetCompletedTables",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GetCompletedTables').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "loadData",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "AzureSqlSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false,
									"tableOption": "autoCreate",
									"disableMetricsCollection": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "SqlServerTable",
									"type": "DatasetReference",
									"parameters": {
										"table": {
											"value": "@item().TableName",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "adventureWorksDatabase",
									"type": "DatasetReference",
									"parameters": {
										"table": {
											"value": "@item().TableName",
											"type": "Expression"
										},
										"schema": "dbo"
									}
								}
							]
						},
						{
							"name": "updateDb",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "loadData",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "lnk_onpremsql",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": "UPDATE AzureSyncControl \nSET Status = 'PROCESSED' \nWHERE TableName = 'DimAccount' \n  AND LoadDate = CAST(GETDATE() AS DATE);"
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			},
			{
				"name": "GetCompletedTables",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "AllTablesLoaded",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "SELECT TableName FROM dbo.AzureSyncControl WHERE LoadDate = CAST(GETDATE() AS DATE) AND Status = 'COMPLETED';",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SqlServerOnPrem",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			}
		],
		"variables": {
			"IsAllCompleted": {
				"type": "Boolean",
				"defaultValue": false
			}
		},
		"folder": {
			"name": "AdventureWorks"
		},
		"annotations": []
	}
}