{
	"name": "AutomatedPipeline",
	"properties": {
		"description": "Pipeline to load data.\nAutomate based on the current date to pick the folder and process the files.",
		"activities": [
			{
				"name": "getFiles",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "validateControlFile",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_automated_date",
						"type": "DatasetReference",
						"parameters": {
							"folderpath": {
								"value": "@formatDateTime(utcNow(), 'yyyy-MM-dd')",
								"type": "Expression"
							},
							"filename": "@string('')"
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "filterfiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('filterfiles').output.Value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "loadData",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "AzureSqlSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": true
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_automated_date",
									"type": "DatasetReference",
									"parameters": {
										"folderpath": {
											"value": "@formatDateTime(utcNow(), 'yyyy-MM-dd')",
											"type": "Expression"
										},
										"filename": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "adventureWorksDatabase",
									"type": "DatasetReference",
									"parameters": {
										"table": {
											"value": "@split(split(item().name, '_')[1], '.')[0]",
											"type": "Expression"
										},
										"schema": "@split(item().name, '_')[0]"
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "validateControlFile",
				"description": "Verify if the control file exists and then proceed.",
				"type": "Validation",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_automated_date",
						"type": "DatasetReference",
						"parameters": {
							"folderpath": {
								"value": "@formatDateTime(utcNow(), 'yyyy-MM-dd')",
								"type": "Expression"
							},
							"filename": "success.ctl"
						}
					},
					"timeout": "0.12:00:00",
					"sleep": 60
				}
			},
			{
				"name": "filterfiles",
				"description": "exclude controlfile.",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "getFiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('getFiles').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@not(equals(item().name, 'success.ctl'))",
						"type": "Expression"
					}
				}
			}
		],
		"folder": {
			"name": "AdventureWorks"
		},
		"annotations": []
	}
}