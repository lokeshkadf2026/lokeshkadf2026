{
	"name": "SqltoCSVOnprem",
	"properties": {
		"description": "On prem databases  : Using self hosted integration runtime",
		"activities": [
			{
				"name": "getTables",
				"description": "",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "SELECT t.name AS TableName\nFROM sys.tables t\nWHERE t.is_ms_shipped = 0;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SqlServerTable",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			}
		],
		"folder": {
			"name": "AdventureWorks"
		},
		"annotations": []
	}
}